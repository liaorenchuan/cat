# ============================================================
#  构建产物与依赖 —— 体积大，可由源码重新生成
# ============================================================

# --- .NET / Visual Studio ---
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
*.nupkg

# --- Node / Electron ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Inno Setup 输出 ---
inno/Output/

# ============================================================
#  二进制文件 —— 默认全部忽略，仅白名单保留
#  （含 node.exe / cloudflared.exe / electron.exe / 安装包 / APK）
# ============================================================
*.exe
*.dll
*.pdb
*.so
*.dylib
*.apk
*.aab
*.apks
*.ipa
*.msi

# 保留：体积小且是项目配套工具
!inkm/quit.exe
!inkm/智能键鼠.exe

# inkm/server/bin 内有源码 (input-daemon.cpp)，需放行目录本身
# 目录恢复后，其中的 *.exe 仍会被上面的规则忽略
!inkm/server/bin/

# ============================================================
#  数据库与运行时数据
# ============================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# inkm 运行时临时文件（保留目录占位文件）
inkm/data/*
!inkm/data/.gitkeep

# ============================================================
#  编辑器 / 操作系统
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~
