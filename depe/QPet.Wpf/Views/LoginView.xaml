<UserControl x:Class="QPet.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="OnKeyDown" Focusable="True" Loaded="OnLoaded">

    <!-- 登录视图(主窗口内):奶油色渐变背景,与宠物窗口同风格 -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource UiAppBgTopColor}" Offset="0" />
            <GradientStop Color="{StaticResource UiAppBgColor}" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <!-- 垂直居中适配窗口(小窗口自动滚动) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Center">
        <StackPanel MaxWidth="540" Margin="24" HorizontalAlignment="Center">

            <!-- 标题:渐变圆底图标 + 主标题(注册模式整体换装) -->
            <Border Width="104" Height="104" CornerRadius="52" HorizontalAlignment="Center"
                    Background="{StaticResource WarmSurface}" BorderBrush="{StaticResource WarmBorder}" BorderThickness="1">
                <TextBlock Text="🐱" FontSize="52" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Text="Q版桌宠" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource WarmTitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="SubtitleText" Text="局域网聊天 · 好友 · 群聊" FontSize="14"
                       Foreground="{StaticResource UiBrown}" HorizontalAlignment="Center" Margin="0,8,0,18" />

            <!-- 账号密码卡片(注册模式换绿色边框) -->
            <Border x:Name="CardBorder" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- 注册欢迎横幅 -->
                    <Border x:Name="ModeBanner" Visibility="Collapsed"
                            Background="{StaticResource UiGreen}" CornerRadius="6" Padding="12,9" Margin="0,0,0,14">
                        <TextBlock Text="🎉 注册新账号,自动加入公共群聊" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>

                    <!-- 注册模式:昵称(置于账号上方,登录时折叠不占空间) -->
                    <StackPanel x:Name="NicknamePanel" Visibility="Collapsed">
                        <TextBlock Text="昵称" FontSize="13" Foreground="{StaticResource UiDeepBrown}" Margin="0,0,0,6" />
                        <TextBox x:Name="NicknameBox" Height="44" FontSize="16" Padding="12,7" Margin="0,0,0,16" />
                    </StackPanel>

                    <TextBlock Text="账号" FontSize="13" Foreground="{StaticResource UiDeepBrown}" Margin="0,0,0,6" />
                    <TextBox x:Name="AccountBox" Height="44" FontSize="16" Padding="12,7" />
                    <TextBlock Text="密码" FontSize="13" Foreground="{StaticResource UiDeepBrown}" Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordBox" Height="44" FontSize="16" Padding="12,7" />

                    <!-- 记住密码:勾选后密码经 DPAPI 加密存本机,下次打开自动填好 -->
                    <CheckBox x:Name="RememberBox" Content="记住密码" IsChecked="True"
                              FontSize="13" Foreground="{StaticResource UiDeepBrown}" Margin="0,14,0,0" />

                    <!-- 服务器地址:预填记住的地址(默认本机);自动检测在局域网搜索 QPet 服务器并填入 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                        <TextBox x:Name="ServerBox" FontSize="13" Padding="10,5" Height="36"
                                 VerticalContentAlignment="Center"
                                 ToolTip="QPet 服务器地址,形如 192.168.1.5:54321;登录成功自动记住" />
                        <Button Grid.Column="1" x:Name="AutoDetectButton" Style="{StaticResource SecondaryButton}"
                                Content="自动检测" FontSize="13" Height="36" Padding="14,0" Margin="8,0,0,0"
                                Click="OnAutoDetect" ToolTip="在局域网内搜索正在运行的 QPet 服务器,找到自动填入地址" />
                    </Grid>

                    <!-- 错误提示(自动登录失败也回写这里) -->
                    <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource WarmError}"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

                    <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}"
                            Content="登 录" FontSize="17" Padding="12,10" Margin="0,22,0,0"
                            Click="OnSubmitClicked" />

                    <!-- 本地离线登录:不连服务器,用本地缓存直接进软件(宠物/聊天记录可看,消息不可发) -->
                    <Button x:Name="OfflineButton" Content="本地离线登录" FontSize="13"
                            Foreground="{StaticResource WarmSecondary}" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="OnOfflineClicked" />

                    <Button x:Name="ToggleModeButton" Content="没有账号? 注册" FontSize="13"
                            Foreground="{StaticResource WarmSecondary}" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center" Margin="0,2,0,0"
                            Click="OnToggleMode" />
                </StackPanel>
            </Border>

            <TextBlock Text="账号数据在服务器上,宠物与聊天经局域网连接"
                       FontSize="11" Foreground="{StaticResource UiBrownText}" HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
