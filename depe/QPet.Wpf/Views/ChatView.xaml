<UserControl x:Class="QPet.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QPet.Wpf.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <!-- 聊天视图(主窗口内):暖橙渐变背景,衬托白色卡片(对比明显,边界清晰) -->
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource UiAppBgColor}" Offset="0" />
            <GradientStop Color="{StaticResource UiChatBgEndColor}" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Background>

    <UserControl.Resources>
        <!-- 暖色细滚动条(无 Key 隐式样式:本视图所有列表/消息区/输入框统一) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumb" Background="#E6CFAE"
                                                        CornerRadius="4" Margin="1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumb" Property="Background" Value="#D9BC94" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 左列导航项:圆角高亮 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE9D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部页签(选中高亮胶囊) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Padding" Value="24,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource UiBrown}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部页签红点数字(未读/申请计数,0 时隐藏):红底圆角,贴按钮右上角 -->
        <Style x:Key="TabBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WarmError}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,-6,-14,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- 会话条目(消息页):34 圆头像(好友=首字色块+在线点,群=👥 绿块) + 标题/时间 + 预览/未读徽章 -->
        <DataTemplate x:Key="ConvItemTemplate">
            <Grid>
                <!-- 右键菜单:鼠标位置弹出(Windows 文件右键同款),删除会话后对方再发消息自动重新出现 -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="关闭会话" Click="OnDeleteConvMenu" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Grid.RowSpan="2" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AvatarBrush}">
                        <TextBlock Text="{Binding AvatarText}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Stroke="White"
                             StrokeThickness="2" HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" Visibility="{Binding DotVisibility}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                           Foreground="{StaticResource WarmText}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="9"
                           Foreground="{StaticResource UiBrownText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview}" FontSize="10"
                           Foreground="{StaticResource UiBrown}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource WarmError}" CornerRadius="8"
                        MinWidth="16" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding UnreadVisibility}">
                    <TextBlock Text="{Binding UnreadText}" FontSize="9" Foreground="White"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 好友条目(好友页):名字 + 在线圆点 -->
        <DataTemplate x:Key="FriendItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{Binding AvatarBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvatarChar}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource WarmText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Ellipse Width="8" Height="8" Fill="{Binding OnlineBrush}"
                                 Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="{Binding OnlineBrush}" Margin="3,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="{StaticResource UiBrown}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="{StaticResource UiBrownText}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 群聊条目(群聊页):群名 + 群号/人数 -->
        <DataTemplate x:Key="GroupItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{StaticResource UiGreenBg}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="14" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource WarmText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="{StaticResource UiBrown}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="{StaticResource UiBrownText}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 日期栏(时间分组):双横线夹文字居中 -->
        <DataTemplate x:Key="DateBarTemplate">
            <Grid HorizontalAlignment="Center" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="1" Background="#EBD9C0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10" Foreground="{StaticResource UiBrown}"
                           Margin="8,0" />
                <Border Grid.Column="2" Width="26" Height="1" Background="#EBD9C0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 消息气泡:我的深橙右(头像在右) / 对方白左(头像在左);点击头像 → 用户主页 -->
        <DataTemplate x:Key="BubbleTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 系统消息:整行居中灰字(成员变动提示) -->
                <TextBlock Grid.ColumnSpan="3" Text="{Binding Msg.Text}" FontSize="11"
                           Foreground="{StaticResource UiBrown}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding SystemRowVisibility}" />

                <!-- 普通消息:头像 + 气泡 + 头像(系统消息整行隐藏) -->
                <Grid Grid.ColumnSpan="3" Visibility="{Binding BubbleRowVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 对方头像(左,与气泡顶对齐);右下角叠在线状态点(仅私聊显示) -->
                    <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,6,0" VerticalAlignment="Top"
                          Visibility="{Binding ShowLeftAvatar}">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding AvatarBrush}"
                                VerticalAlignment="Top"
                                Cursor="Hand" MouseLeftButtonUp="OnMsgAvatarClick">
                            <TextBlock Text="{Binding AvatarChar}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="{Binding PeerDotBrush}" Stroke="White"
                                 StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Visibility="{Binding PeerDotVisibility}" />
                    </Grid>

                    <!-- 消息区:昵称(气泡外上方) + 已读/气泡 + 时间(气泡外下方),宽度随消息自适应,最长 320 -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- 昵称:气泡外上方,随左右对齐 -->
                        <TextBlock Grid.Row="0" Text="{Binding ShowName}" FontSize="10"
                                   Foreground="{StaticResource UiBrown}" Margin="0,0,0,1"
                                   HorizontalAlignment="{Binding Align}"
                                   Visibility="{Binding NameVisibility}" />
                        <!-- 已读(自己的消息,在气泡左边) + 气泡 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="{Binding Align}">
                            <TextBlock Text="{Binding ReadText}" FontSize="9" Foreground="{StaticResource UiBrownText}"
                                       Margin="0,0,4,0" VerticalAlignment="Bottom"
                                       Visibility="{Binding ReadVisibility}" />
                            <Border MaxWidth="320" CornerRadius="10" Padding="10,7"
                                    Background="{Binding BubbleBrush}" BorderBrush="{StaticResource WarmCardBorder}"
                                    BorderThickness="{Binding BubbleBorder}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C9A47C" BlurRadius="6" ShadowDepth="1" Opacity="0.22" />
                                </Border.Effect>
                                <TextBlock Text="{Binding Msg.Text}" FontSize="16"
                                           Foreground="{Binding TextBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <!-- 时间:气泡外下方,随左右对齐 -->
                        <TextBlock Grid.Row="2" Text="{Binding TimeText}" FontSize="9" Foreground="{StaticResource UiBrownText}"
                                   HorizontalAlignment="{Binding Align}" Margin="0,2,0,0" />
                    </Grid>

                    <!-- 自己的头像(右,与气泡顶对齐);右下角叠我的在线状态点 -->
                    <Grid Grid.Column="2" Width="34" Height="34" Margin="6,0,0,0" VerticalAlignment="Top"
                          Visibility="{Binding ShowRightAvatar}">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding AvatarBrush}"
                                VerticalAlignment="Top"
                                Cursor="Hand" MouseLeftButtonUp="OnMsgAvatarClick">
                            <TextBlock Text="{Binding AvatarChar}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="9" Height="9" Fill="{Binding MyDotBrush}" Stroke="White"
                                 StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 消息区模板选择:日期栏 / 气泡按条目类型分发 -->
        <local:MessageTemplateSelector x:Key="MsgTemplateSelector"
                                       DateBarTemplate="{StaticResource DateBarTemplate}"
                                       BubbleTemplate="{StaticResource BubbleTemplate}" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 离线模式横幅 -->
            <RowDefinition Height="*" />     <!-- 内容 -->
            <RowDefinition Height="Auto" />  <!-- 底部页签 -->
        </Grid.RowDefinitions>

        <!-- 离线模式横幅:离线登录 / 断网时提示,常驻顶部 -->
        <Border x:Name="OfflineBanner" Grid.Row="0" Visibility="Collapsed"
                Background="#FFF4E5" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                BorderBrush="{StaticResource WarmBorder}" BorderThickness="1">
            <TextBlock x:Name="OfflineText" FontSize="12" Foreground="{StaticResource WarmText}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <!-- ============ 内容区:消息 / 好友 / 群聊 / 宠物 四个面板 ============ -->
        <Grid Grid.Row="1">

            <!-- 消息页:会话列表 + 聊天窗 -->
            <Grid x:Name="MsgPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏:白色卡片(昵称账户 + 分隔线 + 会话列表),与聊天窗卡片并排明确分隔 -->
                <Border Grid.Column="0" Margin="0,0,10,0" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 昵称账户 -->
                            <RowDefinition Height="Auto" />  <!-- 分隔线 -->
                            <RowDefinition Height="*" />     <!-- 会话列表 -->
                        </Grid.RowDefinitions>

                    <Border x:Name="AvatarCard" Grid.Row="0" Cursor="Hand"
                            MouseLeftButtonUp="OnAvatarClick"
                            MouseEnter="OnAvatarHoverIn" MouseLeave="OnAvatarHoverOut"
                            Background="#FFF8EF" CornerRadius="8" Padding="8" Margin="0,0,0,8"
                            BorderBrush="{StaticResource WarmCardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="34" Height="34">
                                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource WarmSurfacePressed}">
                                    <TextBlock x:Name="AvatarText" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <!-- 我的在线状态点:连接时绿,离线/断网灰 -->
                                <Ellipse x:Name="MyStatusDot" Width="9" Height="9" Fill="Silver" Stroke="White"
                                         StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MyNickText" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WarmText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MyAccountText" FontSize="10" Foreground="{StaticResource UiBrown}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="{StaticResource UiBrownText}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource WarmCardBorder}" Margin="0,0,0,8" />

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ConvList"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 ItemTemplate="{StaticResource ConvItemTemplate}"
                                 SelectionChanged="OnConvSelected" />
                        <TextBlock x:Name="ConvEmptyText" Text="暂无会话&#10;去好友 / 群聊页找人聊聊吧"
                                   FontSize="12" Foreground="{StaticResource UiBrownText}" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 聊天窗:整块白色卡片(会话头 + 消息区 + 输入行),与左栏卡片明确分隔 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 会话头:会话操作(备注/改名/群成员/退群/删除好友),底部细线分隔消息区 -->
                        <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource WarmCardBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="DeleteFriendButton" DockPanel.Dock="Right" Content="✂ 删除好友"
                                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="OnDeleteFriend" />
                            <!-- 群备注:位于改名按钮右侧,按钮文字显示当前备注名(有备注时) -->
                            <Button x:Name="GroupRemarkButton" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="OnGroupRemark" />
                            <Button x:Name="ConvActionButton" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                    Click="OnConvAction" />
                            <Button x:Name="MembersButton" DockPanel.Dock="Right" Content="👥 成员"
                                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="OnMembers" />
                            <Button x:Name="LeaveGroupButton" DockPanel.Dock="Right" Content="🚪 退群"
                                    Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="OnLeaveGroup" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 私聊:对方在线状态点(绿=在线 灰=离线/断网);群聊不显示 -->
                                <Ellipse x:Name="ConvDot" Width="10" Height="10" Fill="Silver" Stroke="White"
                                         StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Visibility="Collapsed" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ConvTitleText" FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource WarmText}" />
                                    <TextBlock x:Name="ConvSubText" FontSize="10" Foreground="{StaticResource UiBrown}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 消息区:虚拟化渲染,历史消息再多也不卡(只渲染可见气泡) -->
                    <ScrollViewer x:Name="MsgScroll" Grid.Row="1" Margin="0,8" Background="White"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl x:Name="MsgList" ItemTemplateSelector="{StaticResource MsgTemplateSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 输入行:一体式输入条——emoji/输入框/两按钮等高(90)填满整行,按钮各半高(43+4+43);
                         Enter 发送,Shift+Enter 或「换行」插入换行;顶部细线分隔消息区 -->
                    <Border Grid.Row="2" Padding="12,4" BorderBrush="{StaticResource WarmCardBorder}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 输入条:emoji/输入框/两按钮(展开表情面板时整体上移,消息区被压缩) -->
                            <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 输入框 + 状态提示同格叠加:提示浮在输入框右下角,不参与布局(避免撑高错位) -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="MsgInput" FontSize="16" Background="White"
                                         BorderBrush="{StaticResource WarmCardBorder}" Padding="10,2"
                                         TextBlock.LineHeight="24"
                                         MinHeight="45" MaxHeight="90"
                                         VerticalAlignment="Bottom"
                                         VerticalContentAlignment="Center"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="OnInputTextChanged"
                                         PreviewKeyDown="OnInputKeyDown" />
                                <TextBlock x:Name="StatusText" FontSize="10" Foreground="{StaticResource WarmError}"
                                           TextWrapping="Wrap" Margin="0,0,6,8"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <!-- emoji:大圆钮(45x45)在「更多」左边,点开表情面板 -->
                            <Button Grid.Column="1" Content="😊" FontSize="20"
                                    Width="45" Height="45" VerticalAlignment="Bottom" Margin="8,0,8,0"
                                    ToolTip="表情" Click="OnEmojiToggle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{StaticResource UiOrangePale}" CornerRadius="22.5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurfacePressed}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource UiOrangeLight}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- 换行:同款圆钮(45x45),在 😊 和「发送」中间,点击在光标处插入换行 -->
                            <Button Grid.Column="2" Content="↵" FontSize="20"
                                    Width="45" Height="45" VerticalAlignment="Bottom" Margin="0,0,8,0"
                                    ToolTip="换行" Click="OnNewLine">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{StaticResource UiOrangePale}" CornerRadius="22.5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurfacePressed}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource UiOrangeLight}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- 发送:随输入条整体撑高(输入框变高时同步拉伸) -->
                            <Button Grid.Column="3" Margin="0,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="发送" Width="80" FontSize="13"
                                    Padding="10,4" VerticalAlignment="Stretch"
                                    MinHeight="45" Click="OnSend" />
                            </Grid>
                            <!-- 表情面板:内嵌在输入条下方,展开时占布局(消息区上移),点 😊 切换 -->
                            <Border Grid.Row="1" x:Name="EmojiPanel" Visibility="Collapsed"
                                    Background="{StaticResource UiDialogBg}" BorderBrush="{StaticResource WarmCardBorder}" BorderThickness="0,1,0,0"
                                    Margin="0,6,0,0" Padding="8,6">
                                <WrapPanel x:Name="EmojiWrap" />
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 好友页:搜索 + 通知 + 好友列表(白色卡片,与消息页风格统一) -->
            <DockPanel x:Name="FriendPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="🔍 搜索好友"
                                Click="OnAddFriend" Margin="0,0,6,0" />
                        <Button x:Name="FriendRequestsButton" Style="{StaticResource SecondaryButton}"
                                Content="📮 好友申请" Click="OnFriendRequests" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox x:Name="FriendList"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 ItemTemplate="{StaticResource FriendItemTemplate}"
                                 SelectionChanged="OnFriendSelected" />
                        <TextBlock x:Name="FriendEmptyText" Text="还没有好友&#10;点击上方「搜索好友」添加"
                                   FontSize="12" Foreground="{StaticResource UiBrownText}" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextAlignment="Center" />
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 群聊页:创建 + 搜索 + 通知 + 群列表(白色卡片,与消息页风格统一) -->
            <DockPanel x:Name="GroupPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="＋ 创建群聊"
                                Click="OnCreateGroup" Margin="0,0,6,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="🔍 搜索群聊"
                                Click="OnSearchGroup" Margin="0,0,6,0" />
                        <Button x:Name="GroupRequestsButton" Style="{StaticResource SecondaryButton}"
                                Content="📮 群申请" Click="OnGroupRequests" Margin="0,0,6,0" />
                        <Button x:Name="GroupInvitesButton" Style="{StaticResource SecondaryButton}"
                                Content="📮 群邀请" Click="OnGroupInvites" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <ListBox x:Name="GroupList"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 ItemTemplate="{StaticResource GroupItemTemplate}"
                                 SelectionChanged="OnGroupSelected" />
                        <TextBlock x:Name="GroupEmptyText" Text="还没有群聊&#10;点击上方「创建群聊」建一个"
                                   FontSize="12" Foreground="{StaticResource UiBrownText}" LineHeight="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextAlignment="Center" />
                    </Grid>
                </Border>
            </DockPanel>

            <!-- 宠物页:小屋 + 宠物(外出 → 悬浮窗) -->
            <local:PetHouseView x:Name="PetHouseHost" Visibility="Collapsed" />
        </Grid>

        <!-- ============ 底部页签:消息 / 好友 / 群聊 / 宠物(4 等分均宽) ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="TabMsgButton" Style="{StaticResource TabButton}"
                        Click="OnTabMessage">
                    <Grid>
                        <TextBlock Text="💬 消息" />
                        <Border x:Name="MsgTabBadge" Style="{StaticResource TabBadge}">
                            <TextBlock x:Name="MsgTabBadgeText" FontSize="9" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button Grid.Column="1" x:Name="TabFriendButton" Style="{StaticResource TabButton}"
                        Click="OnTabFriends">
                    <Grid>
                        <TextBlock Text="👤 好友" />
                        <Border x:Name="FriendTabBadge" Style="{StaticResource TabBadge}">
                            <TextBlock x:Name="FriendTabBadgeText" FontSize="9" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button Grid.Column="2" x:Name="TabGroupButton" Style="{StaticResource TabButton}"
                        Click="OnTabGroups">
                    <Grid>
                        <TextBlock Text="👥 群聊" />
                        <Border x:Name="GroupTabBadge" Style="{StaticResource TabBadge}">
                            <TextBlock x:Name="GroupTabBadgeText" FontSize="9" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>
                <Button Grid.Column="3" x:Name="TabPetButton" Style="{StaticResource TabButton}" Content="🐱 宠物"
                        Click="OnTabPet" />
            </Grid>
        </Border>

        <!-- 个人主页 Popup(悬浮层,不参与布局) -->
        <Popup x:Name="ProfilePopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=AvatarCard}"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Card}" Background="White" Width="230" Padding="14">
                <StackPanel>
                    <TextBlock x:Name="ProfileNameText" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WarmText}" />
                    <TextBlock x:Name="ProfileAccountText" FontSize="11" Foreground="{StaticResource UiBrown}" Margin="0,2,0,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="改昵称"
                            Margin="0,10,0,0" Click="OnChangeNickname" />
                    <Button Style="{StaticResource SecondaryButton}" Content="退出登录"
                            Margin="0,8,0,0" Click="OnLogout" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 别人主页 Popup(群聊点头像):资料 + 加好友 -->
        <Popup x:Name="UserPopup" StaysOpen="False" Placement="Center"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Card}" Background="White" Width="250" Padding="16">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource WarmSurfacePressed}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="UserAvatarText" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UserNameText" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource WarmText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="UserAccountText" FontSize="11" Foreground="{StaticResource UiBrown}"
                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                    <TextBlock x:Name="UserHintText" FontSize="11" Foreground="{StaticResource UiBrown}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <Button x:Name="UserAddButton" Style="{StaticResource PrimaryButton}"
                            Content="＋ 添加好友" Margin="0,10,0,0" Click="OnUserAddFriend" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
