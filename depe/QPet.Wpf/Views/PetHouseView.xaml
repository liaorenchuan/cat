<UserControl x:Class="QPet.Wpf.Views.PetHouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged">

    <!-- 宠物小屋视图(宠物页签):暖橙纯色背景,衬托白色活动区(对比明显);左侧标题/置顶竖栏 -->
    <UserControl.Background>
        <SolidColorBrush Color="#FFEBD2" />
    </UserControl.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />  <!-- 左栏:小屋标题 + 置顶 -->
            <ColumnDefinition Width="*" />   <!-- 宠物区 -->
        </Grid.ColumnDefinitions>

        <!-- 左栏:小屋标题(竖排)在上,置顶 / 缩放开关在下 -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0,16,0,14"
                Margin="12,12,4,12" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="🏡" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="小屋" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarmTitle}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                <Button x:Name="TopmostButton" Style="{StaticResource ActionButton}"
                        Content="🔝" Margin="6,24,6,0" Padding="0,6"
                        Click="OnToggleTopmost" ToolTip="窗口置顶:始终显示在其他窗口之上" />
                <TextBlock x:Name="TopmostText" Text="置顶" FontSize="10" Foreground="{StaticResource UiBrown}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <Button x:Name="ScaleButton" Style="{StaticResource ActionButton}"
                        Content="🔍" Margin="6,12,6,0" Padding="0,6"
                        Click="OnScale" ToolTip="缩放模式:拖拽宠物调整大小(再点取消)" />
                <TextBlock x:Name="ScaleText" Text="缩放" FontSize="10" Foreground="{StaticResource UiBrown}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 宠物活动区(纯色版:无任何装饰,动作全部走右键点宠物弹出的菜单) -->
        <Grid Grid.Column="1" x:Name="PetArea">
                <Border Margin="4,12,12,12" CornerRadius="16" Background="{StaticResource UiAppBgTop}"
                        BorderBrush="#F0DFC9" BorderThickness="1" />

                <!-- 桌宠角色:在区域内自由走动(X/Y 都由 PetWalk 平移,坐标原点贴活动区左上角);
                     左键 = 戳一下(Clicked)/拖拽,右键 = 弹出动作菜单 -->
                <Grid x:Name="PetHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Image x:Name="PetImage" Width="200" Height="200" HorizontalAlignment="Center"
                           MouseRightButtonUp="OnPetRightClick">
                        <Image.RenderTransform>
                            <!-- 走左时 ScaleX=-1 镜像翻转,以宠物中心为轴 -->
                            <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" CenterX="100" CenterY="100" />
                        </Image.RenderTransform>
                    </Image>
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="PetWalk" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                </Grid>

                <!-- 外出中提示:宠物在桌面悬浮窗,小屋留空(默认隐藏,外出时显示) -->
                <StackPanel x:Name="OutsideHint" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎈" FontSize="26" HorizontalAlignment="Center" />
                    <TextBlock Text="宠物外出玩耍中" FontSize="13" Foreground="{StaticResource UiBrown}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="点桌面悬浮宠物「回家」" FontSize="11" Foreground="#C9AE8A"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 右键动作菜单:右键点宠物弹出(与悬浮窗右键菜单同款交互) -->
                <Popup x:Name="ActionMenuPopup" Placement="MousePoint" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Card}" Background="White" Padding="6" MinWidth="132">
                        <StackPanel>
                            <Button Style="{StaticResource ActionButton}" Content="🎈 外出玩耍" Margin="0,0,0,4" Click="OnGoOut" />
                            <Border Height="1" Background="{StaticResource WarmCardBorder}" Margin="0,0,0,4" />
                            <Button Style="{StaticResource ActionButton}" Content="❤ 比心" Margin="0,0,0,4" Click="OnHeart" />
                            <Button Style="{StaticResource ActionButton}" Content="🙏 跪下" Margin="0,0,0,4" Click="OnKneel" />
                            <Button Style="{StaticResource ActionButton}" Content="🍜 吃面" Margin="0,0,0,4" Click="OnEat" />
                            <Button x:Name="SleepMenuButton" Style="{StaticResource ActionButton}" Content="😴 睡觉" Margin="0,0,0,4" Click="OnSleep" />
                            <Button x:Name="WalkMenuButton" Style="{StaticResource ActionButton}" Content="🚶 走路" Click="OnWalk" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- 缩放模式:宠物底部缩放条(滑块调大小)+ 确认按钮 -->
                <StackPanel x:Name="ScalePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,58"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ScaleHintText" Text="拖动滑块调整大小" FontSize="11"
                               Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <!-- 缩放条:暖橙轨道 + 圆形滑块,80-400 -->
                    <Slider x:Name="SizeSlider" Width="240" Minimum="80" Maximum="400"
                            ValueChanged="OnSizeSliderChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid VerticalAlignment="Center">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="{StaticResource WarmPrimary}" CornerRadius="3" Height="6" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="{StaticResource WarmSurfacePressed}" CornerRadius="3" Height="6" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Focusable="False">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Width="18" Height="18" CornerRadius="9"
                                                                Background="{StaticResource WarmPrimary}" BorderBrush="White"
                                                                BorderThickness="2" Cursor="Hand"
                                                                VerticalAlignment="Center" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <TextBlock x:Name="SizeText" Text="200 px" FontSize="11" Foreground="{StaticResource UiBrown}"
                               HorizontalAlignment="Center" Margin="0,6,0,8" />
                    <Button x:Name="ScaleOkButton" Content="✓ OK" FontSize="12" FontWeight="Bold"
                            Foreground="White" Cursor="Hand" Padding="24,6" Click="OnScaleOk">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{StaticResource WarmPrimary}" CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmPrimaryDark}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
</UserControl>
