<Window x:Class="QPet.Wpf.Dialogs.RequestsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="申请" Width="430" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiDialogBg}">

    <Window.Resources>
        <!-- 申请卡片:白卡 + 圆角 12 + 暖橙阴影,悬停浅橙底(与好友列表条目同风格) -->
        <Style x:Key="ReqItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource UiCardBg}" CornerRadius="12" BorderBrush="{StaticResource WarmCardBorder}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#C4702F" BlurRadius="12" ShadowDepth="1" Opacity="0.08" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页签:选中橙色加粗 + 底部 2px 橙条 -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource UiBrown}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="16,7"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource WarmPrimary}" />
                                <Setter Property="Foreground" Value="{StaticResource WarmTitle}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarmTitle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Margin="0,0,0,8">
            <!-- 好友申请 -->
            <TabItem Header="好友申请">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="HintText" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource UiBrown}"
                               Margin="0,0,0,12" Text="待处理的好友申请" />
                    <ListBox x:Name="ReqList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ReqItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 首字头像:与好友列表同款哈希配色 -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{Binding AvatarBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarChar}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FromName}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource WarmText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeHint}" FontSize="10" Foreground="{StaticResource UiBrownText}"
                                                       Margin="8,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource UiDeepBrown}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <!-- 同意=主按钮(橙渐变),拒绝=次按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="同意"
                                                Tag="{Binding}" Click="OnAccept" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="拒绝"
                                                Tag="{Binding}" Click="OnReject" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- 群申请(我是群主/管理员才有) -->
            <TabItem Header="群申请">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="GroupHintText" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource UiBrown}"
                               Margin="0,0,0,12" Text="待审批的加群申请" />
                    <ListBox x:Name="GroupReqList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ReqItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 👥 绿块头像,与群聊条目一致 -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{Binding AvatarBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarChar}" FontSize="14" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding GroupName}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource WarmText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeHint}" FontSize="10" Foreground="{StaticResource UiBrownText}"
                                                       Margin="8,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RequestText}" FontSize="11" Foreground="{StaticResource UiDeepBrown}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="同意"
                                                Tag="{Binding}" Click="OnGroupAccept" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="拒绝"
                                                Tag="{Binding}" Click="OnGroupReject" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- 群邀请(有人拉我进群,需我同意) -->
            <TabItem Header="📨 群邀请">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="InviteHintText" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource UiBrown}"
                               Margin="0,0,0,12" Text="待同意的群邀请" />
                    <ListBox x:Name="InviteList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ReqItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 发起者首字头像,与好友列表同款哈希配色 -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{Binding AvatarBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarChar}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource WarmSecondary}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FromName}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource WarmText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimeHint}" FontSize="10" Foreground="{StaticResource UiBrownText}"
                                                       Margin="8,2,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RequestText}" FontSize="11" Foreground="{StaticResource UiDeepBrown}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="同意"
                                                Tag="{Binding}" Click="OnInviteAccept" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="拒绝"
                                                Tag="{Binding}" Click="OnInviteReject" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
