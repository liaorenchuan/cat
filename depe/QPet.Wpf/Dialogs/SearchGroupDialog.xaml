<Window x:Class="QPet.Wpf.Dialogs.SearchGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索加群" Width="420" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiDialogBg}">

    <Window.Resources>
        <!-- 结果卡片:白卡 + 圆角 12 + 暖橙阴影,悬停浅橙底(与群聊条目同风格) -->
        <Style x:Key="GroupResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource UiCardBg}" CornerRadius="12" BorderBrush="{StaticResource WarmCardBorder}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#C4702F" BlurRadius="12" ShadowDepth="1" Opacity="0.08" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource WarmSurface}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- 搜索行:群名或群号 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="搜索"
                    Width="64" Margin="8,0,0,0" Click="OnSearch" />
            <TextBox x:Name="NumBox" FontSize="13" Height="32" Padding="6,4"
                     VerticalContentAlignment="Center" KeyDown="OnNumKeyDown"
                     TextChanged="OnSearchBoxChanged" ToolTip="输入群名或群号搜索" />
        </DockPanel>

        <TextBlock x:Name="HintText" DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource UiBrown}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="输入群名或群号搜索(群号在群聊列表和会话头部显示),点结果直接加入或申请。" />

        <!-- 结果候选列表(可多个,公共群排最前):👥 头像 + 群名/徽章 + 加入按钮 -->
        <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource GroupResultItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                Background="{Binding AvatarBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AvatarChar}" FontSize="14" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource WarmText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Background="{Binding KindBrush}" CornerRadius="8"
                                        Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindText}" FontSize="9" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding MetaText}" FontSize="10" Foreground="{StaticResource UiBrown}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- 可加入=主按钮(橙渐变);已入群/已申请=禁用自动变灰 -->
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Content="{Binding BtnText}" IsEnabled="{Binding CanAct}"
                                Tag="{Binding}" Click="OnJoin" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 提示 / 错误 -->
        <TextBlock x:Name="ErrText" DockPanel.Dock="Bottom" FontSize="11" Foreground="{StaticResource WarmError}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </DockPanel>
</Window>
