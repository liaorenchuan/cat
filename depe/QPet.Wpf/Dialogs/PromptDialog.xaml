<Window x:Class="QPet.Wpf.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiDialogBg}" KeyDown="OnKeyDown">

    <StackPanel Margin="20,16">
        <TextBlock x:Name="PromptText" FontSize="12" Foreground="{StaticResource UiDeepBrown}" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Height="32" FontSize="13" Padding="6,4" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Width="70" Click="OnCancel" />
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Width="70" Margin="10,0,0,0" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
