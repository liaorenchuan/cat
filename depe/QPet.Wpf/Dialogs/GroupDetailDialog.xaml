<Window x:Class="QPet.Wpf.Dialogs.GroupDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="群聊详情" Width="380" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource UiDialogBg}">

    <DockPanel Margin="16">
        <!-- 头部:头像 + 群名 + 群号/成员 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource UiCardBg}" CornerRadius="12" Padding="14"
                BorderBrush="{StaticResource WarmCardBorder}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource UiGreenBg}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="NameText" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WarmText}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock x:Name="NumText" FontSize="11" Foreground="{StaticResource UiBrown}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock x:Name="MemberText" FontSize="11" Foreground="{StaticResource UiBrown}"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 群名修改(群成员都可改名,服务器持久化,全员可见) -->
        <StackPanel DockPanel.Dock="Top" Visibility="Collapsed" x:Name="RenamePanel">
            <TextBlock Style="{StaticResource SectionTitle}" Text="● 群名" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Content="保存群名" Width="80" Margin="8,0,0,0" Click="OnSaveName" />
                <TextBox x:Name="NameBox" FontSize="13" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" MaxLength="20" />
            </DockPanel>
            <TextBlock Text="改名后群成员都会看到新群名。" FontSize="10"
                       Foreground="{StaticResource UiBrownText}" Margin="0,0,0,10" />
        </StackPanel>

        <!-- 群备注:本地修改,只有自己可见(会话列表/群列表显示备注优先) -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="● 群备注" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        Content="保存备注" Width="80" Margin="8,0,0,0" Click="OnSaveRemark" />
                <TextBox x:Name="RemarkBox" FontSize="13" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" MaxLength="20"
                         ToolTip="自己看的备注,不影响群名" />
            </DockPanel>
            <TextBlock Text="群备注只有自己可见,消息页与群聊页会优先显示备注。" FontSize="10"
                       Foreground="{StaticResource UiBrownText}" Margin="0,0,0,10" />
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel DockPanel.Dock="Bottom">
            <Button Style="{StaticResource PrimaryButton}" Content="💬 发消息" FontSize="14"
                    Padding="0,10" Click="OnOpenChat" />
            <Button x:Name="LeaveButton" Style="{StaticResource SecondaryButton}" Content="🚪 退出群聊"
                    Foreground="{StaticResource WarmError}" Margin="0,8,0,0" Padding="0,8" Click="OnLeaveGroup" />
            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{StaticResource WarmError}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
