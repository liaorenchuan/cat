<Window x:Class="QPet.Ui.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White">
    <Border Style="{StaticResource Card}" Margin="18" MinWidth="380">
        <StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="#5C432C"
                       TextWrapping="Wrap" MaxWidth="360" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                        MinWidth="80" Content="取消" Margin="0,0,10,0" IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}"
                        MinWidth="80" Content="确定" IsDefault="True"
                        Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
