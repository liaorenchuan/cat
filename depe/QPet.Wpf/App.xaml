<Application x:Class="QPet.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 暖橙主题基线:本地 Themes/WarmOrange.xaml(桌面端无管理端专属样式);
             以下仅保留桌面端差异覆写与独有样式(本地条目优先于合并字典) -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QPet.Wpf;component/Themes/WarmOrange.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 差异覆写:桌面卡片内边距更紧凑(共享基线 14) -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderBrush" Value="#F0E0CC" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#C4702F" BlurRadius="16" ShadowDepth="2" Opacity="0.10" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 差异覆写:桌面主按钮内边距更紧凑、无禁用触发器(共享基线 14,7 + IsEnabled) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFB066" Offset="0" />
                                        <GradientStop Color="#FF8C42" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF7A2E" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFA35C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 差异覆写:桌面次级按钮内边距更紧凑、无禁用触发器(共享基线 12,6 + IsEnabled) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="#B07A45" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="White" BorderBrush="#E8CFAF" BorderThickness="1"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFF3E6" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFE4C8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 差异覆写:桌面分区标题带下边距(共享基线无 Margin) -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#C4702F" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- 桌面独有:列表去边框透明底,条目高亮由各页 NavItem 控制(共享库只覆盖 ListView) -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- 桌面独有:动作按钮(浅橙底圆角) -->
            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Foreground" Value="#8B5E3C" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#FFF3E6" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFE4C8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFD9AC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
