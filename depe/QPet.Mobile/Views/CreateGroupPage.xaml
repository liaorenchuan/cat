<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QPet.Mobile.Views.Controls"
             x:Class="QPet.Mobile.Views.CreateGroupPage"
             BackgroundColor="#FFFDF9"
             Shell.NavBarIsVisible="False">

    <!-- 创建群页:群名输入 + 好友多选(点行勾选,计数实时更新) + 底部创建 -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="12,0,12,12">

        <controls:SheetHeader x:Name="Sheet" Title="创建群聊" CloseRequested="OnCloseClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- 群名输入 -->
            <VerticalStackLayout Spacing="4" Padding="2,6,2,10">
                <Label Text="群名称" FontSize="13" TextColor="{StaticResource QpText}" Margin="4,0,0,2" />
                <Border StrokeShape="RoundRectangle 12" Stroke="#F0E0CC" BackgroundColor="White" Padding="12,0">
                    <Entry x:Name="NameInput" Placeholder="给群聊起个名字"
                           FontSize="14" TextColor="{StaticResource QpText}"
                           PlaceholderColor="{StaticResource QpBrownText}"
                           TextChanged="OnNameChanged" />
                </Border>
            </VerticalStackLayout>

            <!-- 好友多选列表 -->
            <Border Grid.Row="1" Style="{StaticResource QpCard}" Padding="10,6">
                <Grid RowDefinitions="Auto,*" RowSpacing="0">
                    <Grid ColumnDefinitions="Auto,*" Padding="4,8,4,6">
                        <Label x:Name="CountText" Text="选择好友" FontSize="13"
                               FontAttributes="Bold" TextColor="{StaticResource QpText}" />
                        <Label Grid.Column="1" Text="点击右侧圆圈勾选,可多选"
                               FontSize="10" TextColor="{StaticResource QpBrownText}"
                               HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView Grid.Row="0" Grid.ColumnSpan="2" HeightRequest="1"
                             Color="{StaticResource QpDividerLine}" VerticalOptions="End" />
                    <CollectionView x:Name="FriendList" Grid.Row="1" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="0,40" Spacing="6" HorizontalOptions="Center">
                                <Label Text="😺" FontSize="30" HorizontalTextAlignment="Center" />
                                <!-- 桌面 CreateGroupDialog 无好友文案逐字 -->
                                <Label Text="还没有好友,先添加好友再建群" FontSize="12"
                                       TextColor="{StaticResource QpBrownText}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- 点行整行切换勾选 -->
                                <Grid Padding="6,8" ColumnDefinitions="Auto,*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFriendTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Border WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                                            BackgroundColor="{Binding AvatarBg}" VerticalOptions="Center" Margin="0,0,10,0">
                                        <Label Text="{Binding AvatarText}" FontSize="14"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nick}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource QpText}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Sub}" FontSize="11" TextColor="{StaticResource QpBrown}" />
                                    </VerticalStackLayout>
                                    <!-- 勾选圈:未选描边圆圈,选中橙底 ✓ -->
                                    <Border Grid.Column="2" WidthRequest="22" HeightRequest="22"
                                            StrokeShape="RoundRectangle 11" Stroke="{Binding CheckStroke}"
                                            StrokeThickness="1.5" BackgroundColor="{Binding CheckBg}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding CheckMark}" FontSize="11" FontAttributes="Bold"
                                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部:状态提示 + 创建按钮(群名与勾选齐备才亮;成功后转绿字提示并自动关页) -->
        <VerticalStackLayout Grid.Row="2" Padding="2,0" Spacing="0">
            <Label x:Name="PageTip" FontSize="11" TextColor="{StaticResource QpError}"
                   HorizontalTextAlignment="Center" IsVisible="False" Margin="0,6,0,0" />
            <Button x:Name="CreateBtn" Text="创建群聊" Clicked="OnCreateClicked"
                    FontSize="15" HeightRequest="46" CornerRadius="14" Margin="0,10,0,0"
                    BackgroundColor="#FF8C42" TextColor="White" IsEnabled="False" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>
