<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QPet.Mobile.Views.Controls"
             x:Class="QPet.Mobile.Views.GroupDetailPage"
             BackgroundColor="#FFFDF9"
             Shell.NavBarIsVisible="False">

    <!-- 群详情页:大头像 + 群名/备注/群号/成员数/创建者信息行 + 发消息/退出群聊 -->
    <Grid RowDefinitions="Auto,*">

        <controls:SheetHeader x:Name="Sheet" Title="群详情" CloseRequested="OnCloseClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12,10" Spacing="12">

                <!-- 头部资料卡 -->
                <Border Style="{StaticResource QpCard}" Padding="20,18">
                    <VerticalStackLayout Spacing="6">
                        <Border WidthRequest="72" HeightRequest="72" StrokeShape="RoundRectangle 36"
                                BackgroundColor="#E5F6E0" HorizontalOptions="Center">
                            <Label Text="👥" FontSize="32"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="NameText" FontSize="19" FontAttributes="Bold"
                               TextColor="{StaticResource QpText}" HorizontalTextAlignment="Center" />
                        <Label x:Name="SubText" FontSize="11" TextColor="{StaticResource QpBrown}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- 信息行:群名(改名)/ 群备注(点击改)/ 群号 / 成员数(点击看成员)/ 创建者 -->
                <Border Style="{StaticResource QpCard}" Padding="6,2">
                    <VerticalStackLayout Spacing="0">
                        <!-- 改名行:公共群无创建者语义,整行隐藏(桌面 GroupDetailDialog 公共群隐藏改名) -->
                        <Grid x:Name="RenameRow" Padding="10,12" ColumnDefinitions="Auto,*">
                            <Label Text="群名" FontSize="13" TextColor="{StaticResource QpText}" />
                            <Label Grid.Column="1" x:Name="RowNameText" FontSize="13"
                                   TextColor="{StaticResource QpBrownText}" HorizontalTextAlignment="End" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRenameRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView x:Name="RenameDivider" HeightRequest="1" Color="{StaticResource QpDividerLine}" Margin="10,0" />
                        <Grid x:Name="RemarkRow" Padding="10,12" ColumnDefinitions="Auto,*">
                            <Label Text="群备注" FontSize="13" TextColor="{StaticResource QpText}" />
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0,0,0">
                                <Label x:Name="RemarkText" FontSize="13" TextColor="{StaticResource QpBrownText}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="1" Text="›" FontSize="16"
                                       TextColor="{StaticResource QpBrownText}" Margin="8,0,0,0" />
                            </Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemarkRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView x:Name="RemarkDivider" HeightRequest="1" Color="{StaticResource QpDividerLine}" Margin="10,0" />
                        <Grid Padding="10,12" ColumnDefinitions="Auto,*">
                            <Label Text="群号" FontSize="13" TextColor="{StaticResource QpText}" />
                            <Label Grid.Column="1" x:Name="NumText" FontSize="13"
                                   TextColor="{StaticResource QpBrownText}" HorizontalTextAlignment="End" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource QpDividerLine}" Margin="10,0" />
                        <!-- 成员数行:点击进群成员页 -->
                        <Grid x:Name="MembersRow" Padding="10,12" ColumnDefinitions="Auto,*">
                            <Label Text="成员" FontSize="13" TextColor="{StaticResource QpText}" />
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0,0,0">
                                <Label x:Name="MemberText" FontSize="13" TextColor="{StaticResource QpBrownText}"
                                       HorizontalTextAlignment="End" />
                                <Label Grid.Column="1" Text="›" FontSize="16"
                                       TextColor="{StaticResource QpBrownText}" Margin="8,0,0,0" />
                            </Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMembersRowTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView x:Name="OwnerDivider" HeightRequest="1" Color="{StaticResource QpDividerLine}"
                                 Margin="10,0" IsVisible="False" />
                        <Grid x:Name="OwnerRow" Padding="10,12" ColumnDefinitions="Auto,*" IsVisible="False">
                            <Label Text="创建者" FontSize="13" TextColor="{StaticResource QpText}" />
                            <Label Grid.Column="1" x:Name="OwnerText" FontSize="13"
                                   TextColor="{StaticResource QpBrownText}" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 动作:发消息 / 退出群聊(确认后群与群会话一并移除) -->
                <VerticalStackLayout Spacing="10">
                    <Button Text="💬 发消息" Clicked="OnMsgClicked" FontSize="14" HeightRequest="42"
                            CornerRadius="12" BackgroundColor="#FF8C42" TextColor="White" />
                    <Button x:Name="QuitGroupButton" Text="🚪 退出群聊" Clicked="OnQuitClicked" FontSize="14"
                            HeightRequest="42" CornerRadius="12"
                            BackgroundColor="#FCE8E2" TextColor="{StaticResource QpError}" />
                    <!-- 状态提示:改名/备注结果(红 = 错误,绿 = 成功;平时隐藏) -->
                    <Label x:Name="PageTip" FontSize="11" TextColor="{StaticResource QpError}"
                           HorizontalTextAlignment="Center" IsVisible="False" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 弹层:改名/群备注输入卡 + 退群确认卡 -->
        <Grid x:Name="Overlay" Grid.RowSpan="2" IsVisible="False">
            <BoxView Color="#000000" Opacity="0.25">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayDimTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <controls:PromptCard x:Name="PromptUi" IsVisible="False"
                                     ConfirmRequested="OnPromptAccepted" CancelRequested="OnOverlayCanceled" />
                <controls:ConfirmCard x:Name="ConfirmUi" IsVisible="False"
                                      ConfirmRequested="OnConfirmAccepted" CancelRequested="OnOverlayCanceled" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
