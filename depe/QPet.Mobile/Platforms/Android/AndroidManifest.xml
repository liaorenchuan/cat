<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- 局域网明文聊天(桌面同款 ws/http):Android 9+ 默认禁 cleartext,须显式放行,否则 HTTP 历史补拉被平台静默拒绝 -->
	<!-- allowBackup=false(D3):默认开着会把聊天缓存(含服务器地址、聊天记录)随系统云备份/换机迁移带走,本应用聊天记录只留在本机 -->
	<application android:allowBackup="false" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="true">
		<!-- 宠物悬浮窗前台服务:Android 8+ 后台限制必须走前台服务保活;Android 14+ 须声明 specialUse 类型并附子类型说明 -->
		<service android:name="com.qpet.mobile.PetOverlayService" android:exported="false" android:foregroundServiceType="specialUse">
			<property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="desktop pet overlay" />
		</service>
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- 组播锁:Android Wi-Fi 省电默认丢入站组播帧,持锁才能收 UDP 发现应答(真机必需) -->
	<uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
	<!-- 宠物悬浮窗:API 23+ 需用户在系统设置里手动开"显示在其他应用上层"(无法运行时弹窗申请) -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
	<!-- Android 13+ 通知需运行时授权:前台服务常驻通知用 -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>