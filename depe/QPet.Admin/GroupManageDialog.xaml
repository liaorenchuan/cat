<admin:AdminDialogBase x:Class="QPet.Admin.GroupManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:QPet.Admin"
        Title="群聊管理" Icon="/Assets/mushroom.ico"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- 群聊条目:👥 头像 + 群名 + 群号/类型 + 人数 -->
        <DataTemplate x:Key="GroupRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="#E5F6E0"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="13" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TitleText}" FontSize="13" Foreground="#5C432C" />
                    <TextBlock Text="{Binding SubText}" FontSize="9" Foreground="#C4A888" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                           Foreground="#B08A62" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 成员条目:昵称(账号) + 群主徽章 + 移出按钮 -->
        <DataTemplate x:Key="MemberRowTemplate">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="移出"
                        FontSize="10" Padding="10,2" Tag="{Binding}" Click="OnRemoveMember" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#5C432C" />
                    <Border Background="#E8B46A" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding OwnerBadgeVisibility}">
                        <TextBlock Text="群主" FontSize="9" Foreground="White" />
                    </Border>
                    <Border Background="#9AB09A" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center" Visibility="{Binding AdminBadgeVisibility}">
                        <TextBlock Text="管理员" FontSize="9" Foreground="White" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左:全部群聊列表 -->
        <DockPanel Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="● 群聊"
                       Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" x:Name="GroupCountText" FontSize="10" Foreground="#B08A62"
                       Margin="0,-4,0,6" />
            <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource WarmListBoxItem}"
                     ItemTemplate="{StaticResource GroupRowTemplate}"
                     SelectionChanged="OnGroupSelected" />
        </DockPanel>

        <!-- 右:群信息 + 成员管理 -->
        <DockPanel Grid.Column="1">
            <!-- 群信息头 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="GroupNameText" FontSize="14" FontWeight="Bold"
                                   Foreground="#5C432C" VerticalAlignment="Center" Text="未选择群聊" />
                        <Border x:Name="KindBadge" Background="#FF8C42" CornerRadius="8"
                                Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="KindText" FontSize="9" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="GroupMetaText" FontSize="10" Foreground="#B08A62" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="RenameButton" Style="{StaticResource SecondaryButton}"
                        Content="✏ 改群名" IsEnabled="False" Click="OnRename" />
                <Button x:Name="AddMemberButton" Style="{StaticResource SecondaryButton}"
                        Content="➕ 添加成员" IsEnabled="False" Margin="8,0,0,0" Click="OnAddMembers" />
                <Button x:Name="DisbandButton" Style="{StaticResource SecondaryButton}"
                        Content="🗑 解散群聊" IsEnabled="False" Margin="8,0,0,0" Click="OnDisband" />
            </StackPanel>

            <TextBlock x:Name="ErrText" DockPanel.Dock="Bottom" FontSize="11" Foreground="#E05B4C"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

            <!-- 成员列表 -->
            <TextBlock DockPanel.Dock="Top" x:Name="MemberHint" FontSize="11" Foreground="#B08A62"
                       Margin="0,10,0,6" Text="选中左侧群聊查看成员,点「移出」把成员踢出该群(不足 2 人自动解散)" />
            <ListBox x:Name="MemberList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource WarmListBoxItem}"
                     ItemTemplate="{StaticResource MemberRowTemplate}" />
        </DockPanel>
    </Grid>
</admin:AdminDialogBase>
