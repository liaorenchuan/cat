<admin:AdminDialogBase x:Class="QPet.Admin.AddGroupMembersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:QPet.Admin"
        Title="添加成员" Icon="/Assets/mushroom.ico"
        Width="400" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">


    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontSize="12" Foreground="#8B5E3C"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <!-- 用户多选(全部用户,排除已在群的;勾选即加入,无需好友关系) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel x:Name="MemberPanel" />
        </ScrollViewer>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="关 闭" Width="72"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="＋ 加入所选"
                    Width="96" Click="OnAdd" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" FontSize="11" Foreground="#E05B4C"
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
    </DockPanel>
</admin:AdminDialogBase>
