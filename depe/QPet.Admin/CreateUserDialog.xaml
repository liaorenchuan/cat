<Window x:Class="QPet.Admin.CreateUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建账户" Icon="/Assets/mushroom.ico"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- 字段标签:小圆点 + 棕字 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8B5E3C" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource FieldLabel}" Text="● 昵称(1-20 字)" />
        <TextBox x:Name="NickBox" FontSize="13" Margin="0,5,0,0" Padding="6,4" KeyDown="OnKeyDown" />
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="● 账号(2-20 位)" />
        <TextBox x:Name="AccountBox" FontSize="13" Margin="0,5,0,0" Padding="6,4" KeyDown="OnKeyDown" />
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="● 密码(至少 4 位)" />
        <PasswordBox x:Name="PassBox" FontSize="13" Margin="0,5,0,0" Padding="6,4" KeyDown="OnKeyDown" />
        <TextBlock x:Name="ErrText" FontSize="11" Foreground="#E05B4C" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Width="72" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="创建" Width="72" Margin="8,0,0,0" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
