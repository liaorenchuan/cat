<admin:AdminDialogBase x:Class="QPet.Admin.AccountDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:QPet.Admin"
        Title="账号详情" Icon="/Assets/mushroom.ico"
        Width="640" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- 好友条目:首字头像 + 在线圆点 + 昵称 + ID -->
        <DataTemplate x:Key="FriendTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding AvatarBrush}"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvatarChar}" FontSize="12" FontWeight="Bold"
                               Foreground="#B07A45" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding OnlineBrush}"
                         Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Nickname}" FontSize="13" Foreground="#5C432C" />
                    <TextBlock Text="{Binding AccountShort}" FontSize="9" Foreground="#C4A888" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding OnlineText}" FontSize="10"
                           Foreground="#B08A62" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 加好友候选:昵称(账号) + 在线状态 + 添加按钮 -->
        <DataTemplate x:Key="FriendCandidateTemplate">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="＋ 添加"
                        Tag="{Binding}" Click="OnFriendCandidateClick" Margin="8,0,0,0"
                        Padding="12,3" FontSize="11" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#5C432C" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding OnlineBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OnlineText}" FontSize="9" Foreground="#B08A62"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- 加群候选:群名 + 群号/类型/人数 + 加入按钮 -->
        <DataTemplate x:Key="GroupCandidateTemplate">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="＋ 加入"
                        Tag="{Binding}" Click="OnGroupCandidateClick" Margin="8,0,0,0"
                        Padding="12,3" FontSize="11" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NameText}" FontSize="12" Foreground="#5C432C" />
                    <TextBlock Text="{Binding MetaText}" FontSize="9" Foreground="#B08A62"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- 群聊条目:👥 绿底圆头像 + 群名 + 类型徽章 + 成员数 -->
        <DataTemplate x:Key="GroupTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="#E5F6E0"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="13" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#5C432C" />
                    <TextBlock Text="{Binding NumText}" FontSize="9" Foreground="#C4A888" />
                </StackPanel>
                <Border Grid.Column="2" Background="{Binding KindBrush}" CornerRadius="8"
                        Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding KindText}" FontSize="10" Foreground="White" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding MemberCountText}" FontSize="11"
                           Foreground="#B08A62" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 页签:选中橙色加粗 + 底部 2px 橙条(与桌面端申请弹窗一致) -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#B08A62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" Padding="16,7"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF8C42" />
                                <Setter Property="Foreground" Value="#C4702F" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C4702F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 头部 -->
            <RowDefinition Height="*" />     <!-- 页签(资料 / 好友 / 群聊) -->
            <RowDefinition Height="Auto" />  <!-- 错误 + 关闭 -->
        </Grid.RowDefinitions>

        <!-- 标题栏:头像 + 昵称 + 账号 -->
        <Border Style="{StaticResource Card}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="21" Background="#FFE4C8">
                    <TextBlock x:Name="AvatarText" FontSize="19" FontWeight="Bold"
                               Foreground="#B07A45" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="#5C432C" />
                        <Border x:Name="StatusBadgeBorder" CornerRadius="8" Padding="8,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusBadge" FontSize="10" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubText" FontSize="10" Foreground="#B08A62" Text="账号资料与关系管理" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 分页内容(与客户端申请弹窗同款页签):每页独占空间,不再堆叠 -->
        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="0,10,0,0">
            <!-- 账号资料:昵称/账号只读,密码可改 -->
            <TabItem Header="账号资料">
                <StackPanel Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="● 昵称" FontSize="12"
                                   Foreground="#8B5E3C" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock x:Name="NicknameText" Grid.Row="0" Grid.Column="1" FontSize="13"
                                   Foreground="#5C432C" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="● 账号" FontSize="12"
                                   Foreground="#8B5E3C" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock x:Name="AccountText" Grid.Row="1" Grid.Column="1" FontSize="13"
                                   Foreground="#5C432C" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="● 密码" FontSize="12"
                                   Foreground="#8B5E3C" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasswordBox" FontSize="13" Height="30" Padding="6,4"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Content="保存新密码" Click="OnSavePassword" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="修改密码后该用户下次登录需使用新密码(已登录的会话保持到下线)。" FontSize="10"
                               Foreground="#C4A888" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>

            <!-- 好友:搜账号/昵称点选加好友 + 好友列表(解除好友) -->
            <TabItem Header="好友">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="UnfriendButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                Content="✂ 解除好友" IsEnabled="False" Click="OnUnfriend" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="● 好友"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="FriendEmptyText" FontSize="11" Foreground="#B08A62"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- 加好友:输账号或昵称实时搜,候选显示在输入框下方,点 ＋ 添加直接建立(跳过申请审批) -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="🔍" FontSize="11" Foreground="#B08A62"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="FriendSearchBox" FontSize="12" Height="28" Padding="6,3"
                                 VerticalContentAlignment="Center" TextChanged="OnFriendSearchChanged"
                                 ToolTip="输入对方账号或昵称搜索,在下方点「＋ 添加」直接加为好友" />
                    </DockPanel>
                    <ListBox x:Name="FriendCandidates" DockPanel.Dock="Top" MaxHeight="150"
                             BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                             ItemContainerStyle="{StaticResource WarmListBoxItem}"
                             ItemTemplate="{StaticResource FriendCandidateTemplate}"
                             Visibility="Collapsed" />
                    <ListBox x:Name="FriendList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource WarmListBoxItem}"
                             ItemTemplate="{StaticResource FriendTemplate}"
                             SelectionChanged="OnFriendSelected" />
                </DockPanel>
            </TabItem>

            <!-- 群聊:直接加群 + 群聊列表(移出群聊) -->
            <TabItem Header="群聊">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="KickButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                Content="🚪 移出群聊" IsEnabled="False" Click="OnKick" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                Content="🆕 创建群" Margin="0,0,6,0" Click="OnCreateGroup"
                                ToolTip="以当前账号为群主创建新群,可带成员账号(无需好友关系)" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="● 群聊"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="GroupEmptyText" FontSize="11" Foreground="#B08A62"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <!-- 加群:输群名或群号实时搜,候选显示在输入框下方,点 ＋ 加入直接进群(跳过申请审批) -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="🔍" FontSize="11" Foreground="#B08A62"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="GroupSearchBox" FontSize="12" Height="28" Padding="6,3"
                                 VerticalContentAlignment="Center" TextChanged="OnGroupSearchChanged"
                                 ToolTip="输入群名或群号搜索,在下方点「＋ 加入」直接进群" />
                    </DockPanel>
                    <ListBox x:Name="GroupCandidates" DockPanel.Dock="Top" MaxHeight="150"
                             BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                             ItemContainerStyle="{StaticResource WarmListBoxItem}"
                             ItemTemplate="{StaticResource GroupCandidateTemplate}"
                             Visibility="Collapsed" />
                    <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource WarmListBoxItem}"
                             ItemTemplate="{StaticResource GroupTemplate}"
                             SelectionChanged="OnGroupSelected" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- 底部:错误 + 关闭 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="ErrText" FontSize="11" Foreground="#E05B4C"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Margin="0,0,10,0" Visibility="Collapsed" />
            <Button Style="{StaticResource PrimaryButton}" Content="关 闭" Width="86"
                    HorizontalAlignment="Right" IsCancel="True" />
        </Grid>
    </Grid>
</admin:AdminDialogBase>
