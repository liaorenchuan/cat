<admin:AdminDialogBase x:Class="QPet.Admin.CreateGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:admin="clr-namespace:QPet.Admin"
        Title="创建群聊" Icon="/Assets/mushroom.ico"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">


    <DockPanel Margin="16">
        <!-- 群名 + 创建 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="创建"
                    Width="72" Margin="8,0,0,0" Click="OnCreate" />
            <StackPanel>
                <TextBlock Text="群名称" FontSize="12" Foreground="#8B5E3C" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Height="32" FontSize="13" Padding="6,4"
                         VerticalContentAlignment="Center" KeyDown="OnNameKeyDown" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="选取成员(可不选,群主为当前账号)" FontSize="12"
                   Foreground="#8B5E3C" Margin="0,0,0,8" />

        <!-- 用户多选(全部用户,勾选即成员,无需好友关系) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <StackPanel x:Name="MemberPanel" />
        </ScrollViewer>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" FontSize="11" Foreground="#E05B4C"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </DockPanel>
</admin:AdminDialogBase>
