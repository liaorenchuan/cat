<Window x:Class="QPet.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QPet 服务器管理"
        Icon="/Assets/mushroom.ico"
        Width="880" Height="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 管理密码登录(启动自动连接上次/本机;下方服务器地址行可自动检测或手输) ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Text="🔑 管理密码:" FontSize="12" Foreground="#5C432C"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <PasswordBox Grid.Column="1" x:Name="AdminPassBox" FontSize="13" Height="30"
                                 VerticalContentAlignment="Center" KeyDown="OnLoginKeyDown" />
                    <Button Grid.Column="2" x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="登录管理端"
                            Margin="8,0,0,0" Height="30" Click="OnLogin" />
                    <Button Grid.Column="3" x:Name="LogoutButton" Style="{StaticResource SecondaryButton}"
                            Content="🚪 退出登录" Margin="8,0,0,0" Height="30" Click="OnLogout"
                            Visibility="Collapsed" ToolTip="退出管理端:清空登录状态,主体区域回到禁用" />
                    <TextBlock Grid.Column="4" x:Name="ConnStatusText" FontSize="11"
                               Foreground="#B08A62" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="5" x:Name="LoginErrorText" FontSize="11" Foreground="#E05B4C"
                               VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>

                <!-- 服务器地址行:预填记住地址(默认本机);「自动检测」搜索局域网服务器,找到填入并自动连接 -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                    <TextBlock Text="🔗 服务器地址:" FontSize="12" Foreground="#5C432C"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="ServerBox" FontSize="13" Height="30"
                             VerticalContentAlignment="Center" Padding="8,0"
                             ToolTip="QPet 服务器地址,形如 192.168.1.5:54321;登录成功自动记住" />
                    <Button Grid.Column="2" x:Name="AutoDetectButton" Style="{StaticResource SecondaryButton}"
                            Content="自动检测" FontSize="12" Height="30" Padding="12,0" Margin="8,0,0,0"
                            Click="OnAutoDetect" ToolTip="在局域网内搜索正在运行的 QPet 服务器,找到自动填入并连接" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 主体:用户管理(未登录整体禁用,登录成功后启用) ============ -->
        <Border Grid.Row="1" x:Name="MainPanel" Style="{StaticResource Card}" IsEnabled="False">
            <DockPanel>
                <!-- 操作按钮行(创建账户登录后可用,其余选中用户才可用) -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="CreateButton" Style="{StaticResource SecondaryButton}"
                            Content="➕ 创建账户" IsEnabled="False" Margin="0,0,6,0" Click="OnCreateUser" />
                    <Button x:Name="BanButton" Style="{StaticResource SecondaryButton}"
                            Content="🚫 禁用" IsEnabled="False" Margin="0,0,6,0" Click="OnBan" />
                    <Button x:Name="UnbanButton" Style="{StaticResource SecondaryButton}"
                            Content="✅ 启用" IsEnabled="False" Margin="0,0,6,0" Click="OnUnban" />
                    <Button x:Name="DeleteButton" Style="{StaticResource SecondaryButton}"
                            Content="🗑 删除" IsEnabled="False" Margin="0,0,6,0" Click="OnDeleteUser" />
                    <Button x:Name="DetailButton" Style="{StaticResource SecondaryButton}"
                            Content="👁 详情" IsEnabled="False" Margin="0,0,6,0" Click="OnDetails"
                            ToolTip="查看账号资料/修改密码/好友与群聊(也可双击账号行)" />
                    <Button x:Name="GroupManageButton" Style="{StaticResource SecondaryButton}"
                            Content="👥 群聊列表" IsEnabled="False" Margin="6,0,0,0" Click="OnGroupManage"
                            ToolTip="管理所有群聊:查看成员/移出/添加成员/解散群" />
                    <Button Style="{StaticResource SecondaryButton}" Content="⟳ 刷新"
                            Margin="6,0,0,0" Click="OnRefresh" />
                    <TextBlock DockPanel.Dock="Right" x:Name="UserCountText" FontSize="11"
                               Foreground="#B08A62" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <Grid>
                    <ListView x:Name="UsersList" BorderThickness="0" Background="Transparent"
                              SelectionMode="Extended"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnListDoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <!-- 列头:浅橙底棕字,可点击排序,鼠标变手型提示 -->
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#C4702F" />
                                <Setter Property="Background" Value="#FFF3E6" />
                                <Setter Property="BorderBrush" Value="#F0E0CC" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="0,0,1,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="Click" Handler="OnColumnHeaderClick" />
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <!-- 行:透明底 + 悬停浅橙 + 选中橙高亮 + 圆角(与暖橙主题一致,替代系统默认白底蓝选) -->
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <!-- GridView 行必须用 GridViewRowPresenter(ContentPresenter 会让所有行共享同一内容) -->
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{TemplateBinding GridView.ColumnCollection}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FFF3E6" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FFE9D2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <!-- 状态列:● 在线(绿) / 离线(灰) / 已禁用(红,优先显示),无额外图标 -->
                                <GridViewColumn Header="状态" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="StateText" Text="{Binding OnlineText}"
                                                       FontSize="12" Foreground="#B08A62" VerticalAlignment="Center" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Online}" Value="True">
                                                    <Setter TargetName="StateText" Property="Foreground" Value="#58B368" />
                                                </DataTrigger>
                                                <!-- 后声明优先:封禁状态覆盖在线状态 -->
                                                <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                                    <Setter TargetName="StateText" Property="Text" Value="已禁用" />
                                                    <Setter TargetName="StateText" Property="Foreground" Value="#E05B4C" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- 账号列:首字头像 + 账号 -->
                                <GridViewColumn Header="账号" Width="280">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="26" CornerRadius="13"
                                                        Background="{Binding AvatarBrush}" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvatarChar}" FontSize="11" FontWeight="Bold"
                                                               Foreground="#B07A45" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Account}" FontSize="12"
                                                           Foreground="#5C432C" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="昵称" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nickname}" FontSize="12"
                                                       Foreground="#5C432C" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="注册时间" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedText}" FontSize="11"
                                                       Foreground="#B08A62" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- 空列表提示:无账号时居中显示,避免空白列表让人误以为没登录成功 -->
                    <TextBlock x:Name="EmptyHintText" Text="暂无用户数据"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="#B08A62"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
