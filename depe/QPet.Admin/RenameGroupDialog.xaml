<Window x:Class="QPet.Admin.RenameGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改群名" Icon="/Assets/mushroom.ico"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="White">
    <Border Style="{StaticResource Card}" Margin="18" MinWidth="320">
        <StackPanel>
            <TextBlock Text="● 新群名(1-20 字)" FontSize="12" Foreground="#8B5E3C" />
            <TextBox x:Name="NameBox" FontSize="13" Margin="0,5,0,0" Padding="6,4" KeyDown="OnKeyDown" />
            <TextBlock x:Name="ErrText" FontSize="11" Foreground="#E05B4C" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="80"
                        IsCancel="True" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="确定" MinWidth="80"
                        IsDefault="True" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
