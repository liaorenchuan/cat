            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QPet.Admin;component/Themes/WarmOrange.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
